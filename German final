<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>기초독문법 기말 준비</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,sans-serif;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);min-height:100vh;padding:20px}
.container{max-width:1200px;margin:0 auto}
.header{text-align:center;color:white;margin-bottom:30px}
.header h1{font-size:2.5em;margin-bottom:10px;text-shadow:2px 2px 4px rgba(0,0,0,0.3)}
.header p{font-size:1.1em;opacity:0.85}
.badge{display:inline-block;background:rgba(230,57,70,0.25);border:1px solid rgba(230,57,70,0.6);color:#e63946;padding:3px 12px;border-radius:20px;font-size:0.8em;margin-top:8px}
.mode-selector{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:30px}
.mode-card{background:rgba(255,255,255,0.07);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:14px 10px;cursor:pointer;transition:all 0.25s;text-align:center;color:white}
.mode-card:hover{background:rgba(255,255,255,0.14);transform:translateY(-3px)}
.mode-card.active{background:rgba(230,57,70,0.3);border-color:rgba(230,57,70,0.7)}
.mode-card.new-badge::after{content:'NEW';display:block;font-size:0.58em;background:#e63946;color:white;border-radius:8px;padding:1px 6px;margin:4px auto 0;width:fit-content}
.mode-card .icon{font-size:1.6em;margin-bottom:5px}
.mode-card h2{font-size:0.82em;margin-bottom:2px;font-weight:600}
.mode-card p{font-size:0.68em;opacity:0.75}
.section-divider{grid-column:1/-1;background:rgba(230,57,70,0.12);border-radius:8px;padding:8px 14px;color:#e8a0a5;font-size:0.78em;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;margin-top:6px}
.study-area{background:rgba(255,255,255,0.97);border-radius:15px;padding:40px;box-shadow:0 8px 32px rgba(0,0,0,0.3);min-height:500px}
.progress-bar{width:100%;height:7px;background:#e0e0e0;border-radius:10px;margin-bottom:25px;overflow:hidden}
.progress-fill{height:100%;background:linear-gradient(90deg,#e63946,#c1121f);width:0%;transition:width 0.3s}
.score{text-align:center;font-size:1.2em;color:#e63946;margin-bottom:18px;font-weight:600}
.flashcard{perspective:1000px;min-height:320px}
.flashcard-inner{position:relative;width:100%;height:100%;min-height:320px;transition:transform 0.6s;transform-style:preserve-3d;cursor:pointer}
.flashcard-inner.flipped{transform:rotateY(180deg)}
.flashcard-front,.flashcard-back{position:absolute;width:100%;height:100%;backface-visibility:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:14px;padding:28px}
.flashcard-front{background:linear-gradient(135deg,#1a1a2e,#0f3460);color:white}
.flashcard-back{background:white;border:3px solid #e63946;transform:rotateY(180deg)}
.word{font-size:2.8em;font-weight:bold;margin-bottom:16px}
.meaning{font-size:2.4em;color:#e63946;margin-bottom:16px}
.info{font-size:1.1em;color:#666;margin-top:12px}
.controls{display:flex;justify-content:center;gap:14px;margin-top:28px;flex-wrap:wrap}
.btn{padding:11px 28px;border:none;border-radius:25px;font-size:1.05em;font-weight:600;cursor:pointer;transition:all 0.25s;box-shadow:0 3px 8px rgba(0,0,0,0.12)}
.btn-primary{background:linear-gradient(135deg,#e63946,#c1121f);color:white}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 5px 14px rgba(230,57,70,0.4)}
.btn-secondary{background:white;color:#e63946;border:2px solid #e63946}
.btn-secondary:hover{background:#e63946;color:white}
.quiz-question{text-align:center;margin-bottom:28px}
.quiz-question h3{font-size:1.8em;color:#222;margin-bottom:16px}
.quiz-word{font-size:2.4em;color:#e63946;font-weight:bold;margin:18px 0}
.quiz-options{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:13px;margin-top:18px}
.option{padding:18px;background:#f5f5f5;border-radius:10px;cursor:pointer;transition:all 0.25s;text-align:center;font-size:1.05em;border:2px solid transparent;user-select:none}
.option:hover{background:#ffe5e7;transform:translateY(-2px)}
.option.correct{background:#4caf50;color:white;border-color:#4caf50}
.option.wrong{background:#f44336;color:white;border-color:#f44336}
.option.disabled{pointer-events:none;opacity:0.7}
.result-message{font-size:1.7em;text-align:center;padding:18px;border-radius:10px;margin:18px 0}
.result-message.success{background:#4caf50;color:white}
.result-message.error{background:#ff9800;color:white}
.wrong-words{background:#fff8f8;border-left:4px solid #e63946;padding:20px;border-radius:8px;margin:20px auto;max-width:750px}
.wrong-words h3{color:#c1121f;margin-bottom:14px;font-size:1.35em}
.wrong-word-item{display:block;padding:14px;margin:10px 0;background:white;border-radius:6px;border-left:3px solid #f44336;box-shadow:0 1px 4px rgba(0,0,0,0.06)}
.exercise-input{width:100%;padding:14px;border:2px solid #ddd;border-radius:8px;font-size:1.15em;margin-top:14px}
.exercise-input:focus{outline:none;border-color:#e63946}
.feedback{margin-top:14px;padding:14px;border-radius:8px;font-weight:600;display:none}
.feedback.correct{background:#4caf50;color:white;display:block}
.feedback.wrong{background:#f44336;color:white;display:block}
.writing-input{width:100%;max-width:480px;padding:18px;border:3px solid #e63946;border-radius:12px;font-size:1.4em;text-align:center;margin:18px auto;display:block}
.writing-input:focus{outline:none;border-color:#c1121f;box-shadow:0 0 10px rgba(230,57,70,0.25)}
.verb-table{width:100%;max-width:560px;margin:18px auto;border-collapse:collapse}
.verb-table th{background:#1a1a2e;color:white;padding:11px;text-align:left}
.verb-table td{padding:9px;border:1px solid #ddd}
.verb-table input{width:100%;padding:7px;border:1px solid #ddd;border-radius:4px}
.verb-table input.correct{background:#e8f5e9;border-color:#4caf50}
.verb-table input.wrong{background:#ffebee;border-color:#f44336}
.exercise-container{max-width:820px;margin:0 auto}
.exercise-question{background:#fafafa;padding:26px;border-radius:10px;margin-bottom:18px;border-left:4px solid #e63946}
.exercise-question h4{color:#e63946;margin-bottom:16px;font-size:1.25em}
.exercise-question p{font-size:1.15em;margin-bottom:18px;color:#222}
.number-display{font-size:3.5em;font-weight:900;color:#1a1a2e;text-align:center;margin:20px 0;letter-spacing:-1px}
.hint-chip{display:inline-block;background:#fff3cd;border:1px solid #ffc107;border-radius:20px;padding:4px 12px;font-size:0.88em;color:#856404;margin:4px}
@media(max-width:768px){.mode-selector{grid-template-columns:repeat(3,1fr)}.study-area{padding:22px}}
</style>
</head>
