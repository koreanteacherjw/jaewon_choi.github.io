    <input type="text" class="exercise-input" id="ain" placeholder="답 입력...">
    <div class="feedback" id="fb"></div></div>
    <div class="controls"><button class="btn btn-primary" id="gsb">제출</button></div></div>`;
    const inp=document.getElementById('ain');
    const sub=()=>{const v=inp.value.trim();if(!v){alert('답을 입력하세요!');return;}
      const cors=c.a.split('/').map(a=>a.trim().toLowerCase().replace(/\s+/g,''));
      const ok=cors.some(a=>v.toLowerCase().replace(/\s+/g,'')===a);
      const fb=document.getElementById('fb');
      if(ok){score++;fb.className='feedback correct';fb.textContent='✅ 정답!';inp.disabled=true;}
      else{wrong.push({question:c.q,answer:c.a,userAnswer:v});fb.className='feedback wrong';fb.textContent='❌ 정답: '+c.a;inp.disabled=true;}
      document.getElementById('gsb').textContent='다음 ➡️';document.getElementById('gsb').onclick=()=>{idx++;renderGQ(t,title);};};
    inp.addEventListener('keypress',e=>{if(e.key==='Enter')sub();});
    document.getElementById('gsb').addEventListener('click',sub);inp.focus();
  }
}
