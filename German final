function numberToGerman(n){
  if(n===0)return "null";
  if(numberWords[n])return n===1?"eins":numberWords[n];
  if(n<20)return numberWords[n];
  if(n<100){const t=Math.floor(n/10)*10,o=n%10;if(o===0)return numberWords[t];return numberWords[o]+"und"+numberWords[t];}
  if(n<1000){const h=Math.floor(n/100),r=n%100,hs=h===1?"ein":numberWords[h];return hs+"hundert"+(r>0?numberToGerman(r).replace(/^eins$/,"ein"):"");}
  if(n<1000000){const th=Math.floor(n/1000),r=n%1000,ths=th===1?"ein":numberToGerman(th).replace(/^eins$/,"ein");return ths+"tausend"+(r>0?numberToGerman(r).replace(/^eins$/,"ein"):"");}
  return String(n);
}
function generateNumberQuestions(count=20){
  const qs=[];
  const ranges=[{min:1,max:19,w:3},{min:20,max:99,w:4},{min:100,max:999,w:3},{min:1000,max:9999,w:2},{min:10000,max:99999,w:1}];
  for(let i=0;i<count;i++){
    const pool=[];ranges.forEach(r=>{for(let w=0;w<r.w;w++)pool.push(r);});
    const r=pool[Math.floor(Math.random()*pool.length)];
    const n=Math.floor(Math.random()*(r.max-r.min+1))+r.min;
    qs.push({number:n,answer:numberToGerman(n)});
  }
  return qs;
}

